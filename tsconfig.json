{
  "compilerOptions": {
    "target": "ES5",
    "lib": [
      "ES6",
      "DOM"
    ],
    "module": "ES6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/ts/**/*.ts",
    "examples/constructor/src/**/*.ts"
  ]
}
